<?xml version="1.0" encoding="windows-1252"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
    Id="*"
    Name="WorkshopManager Server"
    UpgradeCode="B8A2C4D6-E1F3-5A7B-9C0D-2E4F6A8B0C2D"
    Language="1033"
    Codepage="1252"
    Version="0.1.0"
    Manufacturer="WorkshopManager">

    <Package
      Id="*"
      Keywords="Installer"
      Description="WorkshopManager — Servidor de gestión de taller mecánico"
      Manufacturer="WorkshopManager"
      InstallerVersion="500"
      Languages="1033"
      Compressed="yes"
      InstallScope="perMachine"
      SummaryCodepage="1252" />

    <MajorUpgrade AllowDowngrades="yes" />

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1" />
    <Property Id="DiskPrompt" Value="WorkshopManager Server Installation" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder" Name="PFiles">
        <Directory Id="INSTALLDIR" Name="WorkshopManager">
          <Component Id="MainComponent" Guid="A1B2C3D4-E5F6-7A8B-9C0D-1E2F3A4B5C6D" Win64="yes">
            <File
              Id="workshop_server_exe"
              Name="workshop-server.exe"
              DiskId="1"
              Source="..\..\target\release\workshop-server.exe"
              KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="WorkshopManager">
          <Component Id="ShortcutRemoveComponent" Guid="E1F2A3B4-C5D6-7E8F-9A0B-1C2D3E4F5A6B" Win64="yes">
            <RemoveFolder Id="RemoveAppProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\WorkshopManager\Server" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ShortcutComponent" Guid="B2C3D4E5-F6A7-8B9C-0D1E-2F3A4B5C6D7E" Win64="yes">
        <Shortcut
          Id="ServerStartMenuShortcut"
          Name="WorkshopManager Server"
          Description="Iniciar servidor WorkshopManager"
          Target="[INSTALLDIR]workshop-server.exe"
          WorkingDirectory="INSTALLDIR"
          Icon="app.exe" />
        <RegistryValue Root="HKCU" Key="Software\WorkshopManager\Server" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature
      Id="MainFeature"
      Title="WorkshopManager Server"
      Description="Instala el servidor de gestión de taller."
      Level="1"
      ConfigurableDirectory="INSTALLDIR"
      AllowAdvertise="no"
      Display="expand"
      Absent="disallow">

      <ComponentRef Id="MainComponent" />
      <ComponentRef Id="ShortcutComponent" />
      <ComponentRef Id="ShortcutRemoveComponent" />
    </Feature>

    <Icon Id="app.exe" SourceFile="..\..\target\release\workshop-server.exe" />

    <UI>
      <UIRef Id="WixUI_Minimal" />
    </UI>

  </Product>

</Wix>
