<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
    Id="*"
    Name="WorkshopManager Viewer"
    UpgradeCode="D0C4E6F8-A3B5-7C9D-1E2F-4A6B8C0D2E4F"
    Language="1033"
    Codepage="1252"
    Version="!(bind.FileVersion.inventory-viewer.exe)"
    Manufacturer="WorkshopManager">

    <Package
      Id="*"
      Keywords="Installer"
      Description="WorkshopManager — Cliente de escritorio para gestión de taller"
      Manufacturer="WorkshopManager"
      InstallerVersion="450"
      Languages="1033"
      Compressed="yes"
      InstallScope="perMachine"
      SummaryCodepage="1252" />

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1" />
    <Property Id="DiskPrompt" Value="WorkshopManager Viewer Installation" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder" Name="PFiles">
        <Directory Id="INSTALLDIR" Name="WorkshopManager">
          <Component Id="MainComponent" Guid="C3D4E5F6-A7B8-9C0D-1E2F-3A4B5C6D7E8F">
            <File
              Id="inventory-viewer.exe"
              Name="inventory-viewer.exe"
              DiskId="1"
              Source="!(bind.targetDir)\inventory-viewer.exe"
              KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="WorkshopManager" />
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ShortcutComponent" Guid="D4E5F6A7-B8C9-0D1E-2F3A-4B5C6D7E8F9A">
        <Shortcut
          Id="ViewerStartMenuShortcut"
          Name="WorkshopManager Viewer"
          Description="Abrir cliente WorkshopManager"
          Target="[INSTALLDIR]inventory-viewer.exe"
          WorkingDirectory="INSTALLDIR"
          Icon="app.exe" />
        <RegistryValue
          Root="HKCU"
          Key="Software\WorkshopManager\Viewer"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature
      Id="MainFeature"
      Title="WorkshopManager Viewer"
      Description="Instala el cliente de escritorio de taller."
      Level="1"
      ConfigurableDirectory="INSTALLDIR"
      AllowAdvertise="no"
      Display="expand"
      Absent="disallow">

      <ComponentRef Id="MainComponent" />
      <ComponentRef Id="ShortcutComponent" />
    </Feature>

    <Icon Id="app.exe" SourceFile="!(bind.targetDir)\inventory-viewer.exe" />

    <UI>
      <UIRef Id="WixUI_FeatureTree" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="FeatureDlg" Order="99">1</Publish>
    </UI>

  </Product>

</Wix>
